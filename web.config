<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de IIS para el ERP de Excellence Freights (sitio estático). -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <!-- Carpetas que no deben publicarse en internet -->
        <hiddenSegments>
          <add segment="herramientas" />
          <add segment=".git" />
        </hiddenSegments>
        <!-- Nunca servir listas de usuarios, scripts ni documentación interna -->
        <fileExtensions>
          <add fileExtension=".xlsx" allowed="false" />
          <add fileExtension=".xls" allowed="false" />
          <add fileExtension=".csv" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".pdf" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Los navegadores revisan si hay versión nueva en cada visita (para que las actualizaciones se vean de inmediato). -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
